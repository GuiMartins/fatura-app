    <string name="onboarding_welcome_title">Welcome to Casshole</string>
    <string name="onboarding_welcome_description">Analyze your credit card invoices (Nubank, Itaú, Mercado Pago) right on your phone. Everything stays on your device, no server involved.</string>
    <string name="onboarding_upload_title">Send your invoices</string>
    <string name="onboarding_upload_description">Pick the invoice PDF right in the app, or share it from any other app. Casshole recognizes the bank and organizes everything automatically.</string>
    <string name="onboarding_appearance_title">Make it yours</string>
    <string name="onboarding_appearance_description">Pick the theme and how you want to see the month\'s summary. You can change this later in Settings.</string>
    <string name="onboarding_insights_title">Track your spending</string>
    <string name="onboarding_insights_description">See the month\'s summary, compare periods, and fix categories — the app learns and automatically applies your correction to future invoices.</string>
